# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server-only, bypasses RLS.
# Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used by the AIProvider/AIService layer (writing/speaking feedback,
# AI coach, admin content generation). Server-only.
OPENAI_API_KEY=
