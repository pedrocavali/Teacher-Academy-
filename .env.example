# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server-only, bypasses RLS.
# Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used by the AIProvider/AIService layer (writing/speaking feedback,
# AI coach, admin content generation). Server-only. Get a key at
# aistudio.google.com/apikey (free tier, no card required). The provider is
# swappable behind AIProvider (src/lib/ai/) without touching callers.
GEMINI_API_KEY=
